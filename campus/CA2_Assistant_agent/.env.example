# CA2 캠퍼스 생활 Q&A·에이전트 대화 — .env 로 복사해 채운다 (.env 는 커밋하지 않는다). 키는 서버에만 둔다(앱에 넣지 않는다).
# OpenAI 호환 chat/completions 면 무엇이든 — 슬롯 이름은 학사 앱(F1·F11·F12·C4)과 같다. 모델은 정의서 CA2-Q1 에서 정한다.
#   예) 호스팅 API  :  LLM_MAIN_BASE_URL=https://<제공자>/v1          LLM_MAIN_MODEL=<모델 이름>
#   예) 내 PC Ollama :  LLM_MAIN_BASE_URL=http://localhost:11434/v1   LLM_MAIN_API_KEY=ollama   LLM_MAIN_MODEL=<받아 둔 모델>
# 비워 두면 축소 모드(FAQ 키워드 검색 + 칩, CA2-R53)로 돈다.
LLM_MAIN_BASE_URL=
LLM_MAIN_API_KEY=
LLM_MAIN_MODEL=

# 임베딩(하이브리드 검색의 한쪽, CA2-R10). 비워 두면 키워드(BM25) 검색만 쓴다. BASE_URL·API_KEY 를 비우면 위 LLM_MAIN_* 것을 쓴다.
LLM_EMBED_BASE_URL=
LLM_EMBED_API_KEY=
LLM_EMBED_MODEL=
